# Шаблон. Каждая неочевидная зависимость несёт комментарий «почему она».
# Зависимость не заводится раньше кода, который её потребляет.
[project]
name = "<project>"
version = "0.1.0"
requires-python = ">=3.13"
dependencies = [
    "polars>=1.43",
    "duckdb>=1.5",
    "pyarrow>=25.0",          # обмен с DuckDB без копии; .to_pandas() не используется
    # openpyxl бракует ячейку с битым serial даты и роняет чтение файла целиком;
    # calamine отдаёт такую ячейку сырым значением.
    "fastexcel>=0.20",
    # token_set_ratio устойчив к перестановке слов; difflib этого не умеет.
    "rapidfuzz>=3.14",
    "reactable>=0.1.6",       # длинные витрины: поиск и сортировка
    "great-tables>=0.23",     # короткие сводки
    "htmltools>=0.7",
    "xlsxwriter>=3.2",        # constant_memory для больших листов
    "ipykernel>=7.3",
    "nbclient>=0.11",
    "nbformat>=5.11",
    "pyyaml>=6.0",
    # --- графика: ОДИН стек на отчёт ---
    # Стек A (ECharts) пакета не требует: опции — обычный dict, вендор лежит
    # в lab/lib/assets/echarts.min.js и обновляется руками.
    # Стек B: раскомментировать вместе с первым отчётом, который его потребляет.
    # Вендор берётся из самого пакета (plotly/package_data/plotly.min.js),
    # не из CDN: сериализатор и рендерер обязаны быть одной версии.
    # "plotly>=6.8",
]

[project.optional-dependencies]
# Ровно один необязательный класс зависимостей. Его отсутствие обрабатывается
# ДОСТИЖИМОЙ ветвью: без него недоступна одна функция, основной результат тот же.
arbiter = ["chatlas>=0.21", "python-dotenv>=1.2"]
dev = ["pytest>=8.4", "pointblank>=0.25"]

# pandas в проекте нет и не планируется. Проверка: grep -rn "import pandas".

[tool.pytest.ini_options]
pythonpath = ["."]
testpaths = ["tests"]
